+      const copyOpsRail = document.getElementById('copyOpsRail');
+      const copyOpsPerSec = document.getElementById('copyOpsPerSec');
+      const copyOpsDone = document.getElementById('copyOpsDone');
+      const copyTarget = document.getElementById('copyTarget');
+      const copySnapshot = copyTarget ? copyTarget.cloneNode(true) : null;
+      const copyPlan = [
+        { op: 'setText', selector: '[data-copy="brand"]', value: 'FounderCheckout' },
+        { op: 'setText', selector: '[data-copy="status"]', value: 'structure copied' },
+        { op: 'setText', selector: '[data-copy="title"]', value: 'Checkout analytics for solo founders.' },
+        { op: 'setText', selector: '[data-copy="copy"]', value: 'A recreated variant keeps the conversion structure while swapping copy, palette, proof, and CTA for a new business test.' },
+        { op: 'setText', selector: '[data-copy="primary"]', value: 'Launch variant' },
+        { op: 'setText', selector: '[data-copy="secondary"]', value: 'View receipt' },
+        { op: 'addClass', selector: '#copyTarget', value: 'dark' }
+      ];
+      function applyCopyOp(packetOp) {
+        const node = document.querySelector(packetOp.selector);
+        if (!node) return;
+        if (packetOp.op === 'setText') node.textContent = packetOp.value;
+        if (packetOp.op === 'addClass') node.classList.add(packetOp.value);
+      }
+      function benchmarkDomCopy() {
+        if (!copyTarget || !copySnapshot) return;
+        copyTarget.className = copySnapshot.className;
+        copyTarget.innerHTML = copySnapshot.innerHTML;
+        const start = performance.now();
+        let opsDone = 0;
+        for (let i = 0; i < 240; i++) {
+          copyPlan.forEach(op => { applyCopyOp(op); opsDone += 1; });
+          const tile = document.createElement('div');
+          tile.className = 'tile';
+          tile.textContent = 'proof ' + (i % 9);
+          document.querySelector('[data-copy="tiles"]').replaceChildren(tile, tile.cloneNode(true), tile.cloneNode(true));
+          opsDone += 4;
+        }
+        const elapsed = Math.max(.001, performance.now() - start);
+        copyOpsPerSec.textContent = Math.round(opsDone / (elapsed / 1000)).toLocaleString();
+        copyOpsDone.textContent = opsDone.toLocaleString();
+        copyOpsRail.innerHTML = '';
+        ['inspect DOM', 'distill structure', 'setText nodes', 'swap class', 'replace proof tiles', 'emit receipt'].forEach((label, idx) => copyOpsRail.appendChild(opNode(label, idx < 5 ? 100 : 75)));
+      }
+      benchmarkDomCopy();
