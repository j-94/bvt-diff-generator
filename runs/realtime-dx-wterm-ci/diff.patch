--- a/README.md
+++ b/README.md
 
 Live site: https://site-mk0rzu4uw-jasedgws-projects.vercel.app
 
+Realtime DX surface: `site/dx.html` shows the production wedge: DSL packet -> BVT engine -> CI state artifact -> terminal/receipt viewer. It is wterm-ready, but still uses a zero-dependency terminal replay until the package is integrated.
+
 Current release benchmark: 320,000 typed ops -> 10,000 unified patch artifacts in roughly 0.22-0.24s, or about 41k-45k patches/sec at ~776 bytes/patch.
 
 UI factory claim boundary: this throughput can create many candidate UI diffs quickly, but admitted UI quality still requires render checks, design constraints, rollback, and BVT receipts.
--- a/devshell.toml
+++ b/devshell.toml
+[[commands]]
+name = "run-dsl"
+help = "Run a high-level DSL packet through the BVT diff engine and save receipts"
+command = "cargo run -- run-dsl"
+
+[[commands]]
+name = "bench"
+help = "Measure structured op-to-diff throughput"
+command = "cargo run -- bench --iterations 10000 --ops 32"
+
+[[commands]]
+name = "serve-viewer"
+help = "Serve the static DX viewer locally"
+command = "cd site && python3 -m http.server 8080"
+
+[[commands]]
+name = "deploy-preview"
+help = "Deploy the static site as a Vercel preview"
+command = "vercel deploy site -y"
+
+[[commands]]
+name = "tail-ci"
+help = "Watch GitHub Actions state for the current repository"
+command = "gh run list --limit 10"
--- a/site/dx.html
+++ b/site/dx.html
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>BVT Realtime DX</title>
+    <meta name="description" content="Realtime DSL and CI-backed BVT operator surface.">
+    <style>
+      :root { color-scheme: dark; --bg: #050607; --panel: #0b0f0d; --ink: #f4f7f2; --muted: #9ca79f; --line: #26312c; --green: #4cffac; --blue: #89b7ff; --amber: #ffd36e; --red: #ff7d7d; }
+      * { box-sizing: border-box; }
+      body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--ink); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
+      main { min-height: 100vh; display: grid; grid-template-rows: auto 1fr; }
+      header { padding: 18px clamp(14px, 3vw, 34px); border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; gap: 18px; align-items: start; }
+      h1 { margin: 0; font-size: clamp(24px, 5vw, 50px); line-height: .96; letter-spacing: 0; }
+      .sub { margin-top: 8px; color: var(--muted); max-width: 940px; font-size: 14px; line-height: 1.45; }
+      .badge { border: 1px solid var(--line); color: var(--green); padding: 8px 10px; white-space: nowrap; }
+      .layout { min-height: 0; display: grid; grid-template-columns: minmax(320px, .72fr) minmax(420px, 1.28fr); }
+      .left, .right { min-height: 0; padding: clamp(14px, 2vw, 22px); }
+      .left { border-right: 1px solid var(--line); display: grid; gap: 14px; align-content: start; }
+      .panel { border: 1px solid var(--line); background: var(--panel); }
+      .panel h2 { margin: 0; padding: 11px 13px; border-bottom: 1px solid var(--line); color: var(--green); font-size: 13px; }
+      .kv { display: grid; grid-template-columns: 128px 1fr; font-size: 12px; }
+      .kv div { padding: 9px 11px; border-bottom: 1px solid rgba(38,49,44,.7); overflow-wrap: anywhere; }
+      .k { color: var(--muted); background: rgba(255,255,255,.025); text-align: right; }
+      .v { color: var(--ink); } .good { color: var(--green); } .warn { color: var(--amber); }
+      .terminal { height: 100%; min-height: 650px; border: 1px solid var(--line); background: #070a09; display: grid; grid-template-rows: auto 1fr auto; }
+      .bar { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--line); color: var(--muted); }
+      .dot { width: 10px; height: 10px; border-radius: 50%; background: #333; }
+      .dot:nth-child(1) { background: var(--red); } .dot:nth-child(2) { background: var(--amber); } .dot:nth-child(3) { background: var(--green); }
+      #term { overflow: auto; padding: 14px; font-size: 13px; line-height: 1.55; }
+      .line { white-space: pre-wrap; color: #dce6dd; } .prompt { color: var(--green); } .tool { color: var(--blue); } .ok { color: var(--green); } .dim { color: var(--muted); } .err { color: var(--red); }
+      .input { border-top: 1px solid var(--line); padding: 12px 14px; display: flex; gap: 10px; color: var(--muted); }
+      .cursor { width: 8px; height: 16px; background: var(--green); display: inline-block; animation: blink 1s steps(2,start) infinite; transform: translateY(3px); }
+      .flow { display: grid; gap: 8px; padding: 12px; }
+      .step { border: 1px solid var(--line); padding: 10px; display: grid; grid-template-columns: 92px 1fr; gap: 10px; align-items: center; }
+      .step b { color: var(--green); font-size: 12px; } .step span { color: var(--muted); font-size: 12px; line-height: 1.4; }
+      .metrics { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 8px; padding: 12px; }
+      .metric { border: 1px solid var(--line); padding: 10px; min-height: 76px; } .metric span { display: block; color: var(--muted); font-size: 11px; } .metric strong { display: block; margin-top: 8px; color: var(--green); font-size: 22px; }
+      a { color: var(--green); text-decoration: none; }
+      @keyframes blink { 50% { opacity: 0; } }
+      @media (max-width: 940px) { header { display: block; } .badge { display: inline-block; margin-top: 12px; } .layout { grid-template-columns: 1fr; } .left { border-right: 0; border-bottom: 1px solid var(--line); } .terminal { min-height: 560px; } }
+    </style>
+  </head>
+  <body>
+    <main>
+      <header>
+        <div>
+          <h1>BVT Realtime DX</h1>
+          <div class="sub">A small production wedge: DSL packet in, existing engine runs, GitHub Actions saves state, Vercel serves the surface, and the browser renders the run as a terminal plus receipt graph.</div>
+        </div>
+        <div class="badge">wterm-ready / CI-backed / receipt-first</div>
+      </header>
+      <section class="layout">
+        <aside class="left">
+          <section class="panel">
+            <h2>Executor Contract</h2>
+            <div class="kv">
+              <div class="k">repo</div><div class="v good">j-94/bvt-diff-generator</div>
+              <div class="k">entry</div><div class="v">natural language -> DSL packet</div>
+              <div class="k">executor</div><div class="v good">bvt-diff-generator run-dsl</div>
+              <div class="k">CI</div><div class="v">.github/workflows/ci-state.yml</div>
+              <div class="k">terminal</div><div class="v">wterm PTY/log stream next</div>
+              <div class="k">env</div><div class="v">devshell.toml command contract</div>
+            </div>
+          </section>
+          <section class="panel">
+            <h2>Reactive Loop</h2>
+            <div class="flow">
+              <div class="step"><b>INTENT</b><span>Operator asks for a transition at system level.</span></div>
+              <div class="step"><b>DSL</b><span>LM emits compact actions, not manual patch prose.</span></div>
+              <div class="step"><b>ENGINE</b><span>Built binary compiles typed ops, diffs, and receipts.</span></div>
+              <div class="step"><b>CI</b><span>GitHub Actions repeats the run and saves artifact state.</span></div>
+              <div class="step"><b>VIEW</b><span>Browser receives state patches and updates the DX fast.</span></div>
+            </div>
+          </section>
+          <section class="panel">
+            <h2>Browser Evidence</h2>
+            <div class="metrics">
+              <div class="metric"><span>frames</span><strong id="frames">0</strong></div>
+              <div class="metric"><span>DOM ops</span><strong id="mutations">0</strong></div>
+              <div class="metric"><span>elapsed ms</span><strong id="elapsed">0</strong></div>
+            </div>
+          </section>
+        </aside>
+        <section class="right">
+          <div class="terminal">
+            <div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span>bvt-dx@ci-state</span></div>
+            <div id="term" aria-live="polite"></div>
+            <div class="input"><span class="prompt">$</span><span>run-dsl runs/realtime-dx-wterm-ci-dsl.json --run-dir runs/realtime-dx-wterm-ci</span><span class="cursor"></span></div>
+          </div>
+        </section>
+      </section>
+    </main>
+    <script>
+      const started = performance.now();
+      const term = document.getElementById('term');
+      const frames = document.getElementById('frames');
+      const mutations = document.getElementById('mutations');
+      const elapsed = document.getElementById('elapsed');
+      let mutationCount = 0;
+      let frameCount = 0;
+      new MutationObserver(records => { mutationCount += records.length; mutations.textContent = mutationCount.toLocaleString(); }).observe(document.body, { childList: true, subtree: true, characterData: true });
+      const lines = [
+        ['prompt', 'intent: make the repo usable as a realtime DSL DX surface'],
+        ['tool', '$ cargo run -- run-dsl runs/realtime-dx-wterm-ci-dsl.json --run-dir runs/realtime-dx-wterm-ci'],
+        ['ok', 'state: dsl_packet_loaded'],
+        ['ok', 'delta: add dx.html + devshell command contract'],
+        ['ok', 'control: compiled_dsl, generated_unified_diff, wrote_receipts, applied_candidate'],
+        ['ok', 'next_state: transition_applied'],
+        ['tool', '$ gh workflow run ci-state.yml -f transition_packet=runs/realtime-dx-wterm-ci-dsl.json -f run_dir=ci-state/realtime-dx-wterm-ci'],
+        ['dim', 'CI builds engine once, runs tests, runs packet, uploads ci-state artifact'],
+        ['tool', '$ vercel deploy site -y'],
+        ['dim', 'Vercel serves the static viewer; wterm becomes the live terminal adapter after package integration'],
+        ['ok', 'claim boundary: DOM speed proves renderer responsiveness; receipts prove execution']
+      ];
+      function appendLine(kind, text) {
+        const div = document.createElement('div');
+        div.className = 'line ' + kind;
+        div.textContent = text;
+        term.appendChild(div);
+        term.scrollTop = term.scrollHeight;
+        frameCount += 1;
+        frames.textContent = frameCount.toLocaleString();
+        elapsed.textContent = Math.round(performance.now() - started).toLocaleString();
+      }
+      lines.forEach((line, index) => setTimeout(() => appendLine(line[0], line[1]), index * 280));
+      setInterval(() => { elapsed.textContent = Math.round(performance.now() - started).toLocaleString(); }, 250);
+    </script>
+  </body>
+</html>
