{
  "intent": "replace the website with a realtime side-by-side Codex animation generated through the BVT diff generator",
  "base_dir": "/Users/jobs/Desktop/bvt-diff-generator",
  "actions": [
    {
      "kind": "ensure_file",
      "path": "site/index.html",
      "lines": [
        "<!doctype html>",
        "<html lang='en'>",
        "  <head>",
        "    <meta charset='utf-8'>",
        "    <meta name='viewport' content='width=device-width, initial-scale=1'>",
        "    <title>BVT Diff Generator</title>",
        "    <meta name='description' content='Realtime animation of Codex with and without the BVT diff proxy.'>",
        "    <style>",
        "      :root {",
        "        color-scheme: dark;",
        "        --bg: #0d1117;",
        "        --panel: #111821;",
        "        --panel-2: #0f161d;",
        "        --ink: #eef6ee;",
        "        --muted: #9aa8a0;",
        "        --line: #27313a;",
        "        --bad: #ff7a7a;",
        "        --good: #31d59b;",
        "        --blue: #77a7ff;",
        "        --gold: #f4c95d;",
        "      }",
        "      * { box-sizing: border-box; }",
        "      body {",
        "        margin: 0;",
        "        min-height: 100vh;",
        "        background:",
        "          radial-gradient(circle at 18% 10%, rgba(49, 213, 155, .15), transparent 28%),",
        "          radial-gradient(circle at 84% 18%, rgba(119, 167, 255, .16), transparent 30%),",
        "          var(--bg);",
        "        color: var(--ink);",
        "        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;",
        "      }",
        "      main { padding: 34px clamp(16px, 4vw, 56px) 48px; }",
        "      .top { display: flex; justify-content: space-between; gap: 24px; align-items: start; margin-bottom: 28px; }",
        "      h1 { margin: 0; font-size: clamp(42px, 8vw, 92px); line-height: .9; letter-spacing: 0; max-width: 900px; }",
        "      .lead { max-width: 760px; color: var(--muted); font-size: 20px; margin: 18px 0 0; }",
        "      .links { display: flex; gap: 10px; flex-wrap: wrap; justify-content: end; }",
        "      .button { color: var(--ink); text-decoration: none; border: 1px solid var(--line); padding: 10px 13px; background: rgba(17, 24, 33, .76); font-weight: 700; }",
        "      .button.primary { background: var(--good); border-color: var(--good); color: #07110d; }",
        "      .stage { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; min-height: 560px; }",
        "      .lane { background: rgba(17, 24, 33, .88); border: 1px solid var(--line); overflow: hidden; display: grid; grid-template-rows: auto auto 1fr auto; }",
        "      .lane.proxy { border-color: rgba(49, 213, 155, .55); box-shadow: 0 0 0 1px rgba(49, 213, 155, .12) inset; }",
        "      .lane-head { padding: 16px 18px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); }",
        "      .lane h2 { margin: 0; font-size: 20px; letter-spacing: 0; }",
        "      .pill { font: 700 12px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted); border: 1px solid var(--line); padding: 5px 8px; }",
        "      .proxy .pill { color: var(--good); border-color: rgba(49, 213, 155, .55); }",
        "      .meters { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }",
        "      .meter { padding: 14px 16px; border-right: 1px solid var(--line); min-width: 0; }",
        "      .meter:last-child { border-right: 0; }",
        "      .meter span { display: block; color: var(--muted); font-size: 12px; }",
        "      .meter strong { display: block; margin-top: 4px; font: 800 24px ui-monospace, SFMono-Regular, Menlo, monospace; white-space: nowrap; }",
        "      .terminal { position: relative; padding: 16px; overflow: hidden; background: linear-gradient(180deg, rgba(15, 22, 29, .94), rgba(10, 15, 20, .98)); }",
        "      .terminal pre { margin: 0; min-height: 360px; white-space: pre-wrap; font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; color: #d9e6da; }",
        "      .terminal::after { content: ''; position: absolute; inset: auto 0 0; height: 70px; background: linear-gradient(transparent, rgba(10, 15, 20, .97)); pointer-events: none; }",
        "      .diff { display: grid; grid-template-columns: 72px 1fr; gap: 0; border-top: 1px solid var(--line); font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; }",
        "      .diff div { padding: 5px 8px; border-bottom: 1px solid rgba(39, 49, 58, .65); }",
        "      .minus { color: var(--bad); }",
        "      .plus { color: var(--good); }",
        "      .line-no { color: #607080; background: rgba(255, 255, 255, .025); text-align: right; }",
        "      .bars { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }",
        "      .bar-wrap { border: 1px solid var(--line); padding: 13px; background: rgba(17, 24, 33, .68); }",
        "      .bar-label { display: flex; justify-content: space-between; color: var(--muted); font-size: 13px; margin-bottom: 8px; }",
        "      .bar { height: 11px; background: #1b242d; overflow: hidden; }",
        "      .fill { height: 100%; width: 0%; background: var(--bad); transition: width .35s ease; }",
        "      .proxy-fill { background: linear-gradient(90deg, var(--good), var(--blue)); }",
        "      .receipt { margin-top: 16px; border: 1px solid rgba(49, 213, 155, .42); padding: 14px; color: var(--muted); font: 13px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; background: rgba(49, 213, 155, .06); }",
        "      .blink { display: inline-block; width: 8px; height: 15px; margin-left: 3px; background: var(--good); animation: blink 1s steps(2, start) infinite; transform: translateY(2px); }",
        "      @keyframes blink { 50% { opacity: 0; } }",
        "      @media (max-width: 980px) { .top, .stage, .bars { grid-template-columns: 1fr; display: grid; } .links { justify-content: start; } }",
        "    </style>",
        "  </head>",
        "  <body>",
        "    <main>",
        "      <div class='top'>",
        "        <div>",
        "          <h1>BVT Diff Generator</h1>",
        "          <p class='lead'>Codex on the left spends tokens hand-writing patch text. Codex on the right emits ICL-shaped DSL, then the local proxy compiles it into typed ops, diffs, and receipts in real time.</p>",
        "        </div>",
        "        <nav class='links'>",
        "          <a class='button primary' href='https://github.com/j-94/bvt-diff-generator'>GitHub</a>",
        "          <a class='button' href='https://site-8lu283661-jasedgws-projects.vercel.app'>Live site</a>",
        "        </nav>",
        "      </div>",
        "",
        "      <section class='stage' aria-label='Realtime Codex comparison'>",
        "        <article class='lane'>",
        "          <div class='lane-head'><h2>Codex without proxy</h2><span class='pill'>raw patch text</span></div>",
        "          <div class='meters'>",
        "            <div class='meter'><span>ops/sec</span><strong id='rawOps'>0</strong></div>",
        "            <div class='meter'><span>apply risk</span><strong id='rawRisk'>high</strong></div>",
        "            <div class='meter'><span>receipt</span><strong id='rawReceipt'>none</strong></div>",
        "          </div>",
        "          <div class='terminal'><pre id='rawStream'></pre></div>",
        "          <div class='diff' id='rawDiff'></div>",
        "        </article>",
        "",
        "        <article class='lane proxy'>",
        "          <div class='lane-head'><h2>Codex with BVT proxy</h2><span class='pill'>ICL -> DSL -> ops</span></div>",
        "          <div class='meters'>",
        "            <div class='meter'><span>ops/sec</span><strong id='proxyOps'>0</strong></div>",
        "            <div class='meter'><span>apply risk</span><strong id='proxyRisk'>gated</strong></div>",
        "            <div class='meter'><span>receipt</span><strong id='proxyReceipt'>ready</strong></div>",
        "          </div>",
        "          <div class='terminal'><pre id='proxyStream'></pre></div>",
        "          <div class='diff' id='proxyDiff'></div>",
        "        </article>",
        "      </section>",
        "",
        "      <section class='bars'>",
        "        <div class='bar-wrap'>",
        "          <div class='bar-label'><span>Raw patch drift</span><strong id='rawPct'>0%</strong></div>",
        "          <div class='bar'><div class='fill' id='rawBar'></div></div>",
        "        </div>",
        "        <div class='bar-wrap'>",
        "          <div class='bar-label'><span>Proxy admission pipeline</span><strong id='proxyPct'>0%</strong></div>",
        "          <div class='bar'><div class='fill proxy-fill' id='proxyBar'></div></div>",
        "        </div>",
        "      </section>",
        "",
        "      <div class='receipt' id='receiptLine'>S: repo files | Delta: DSL actions | C: path safety + anchors + receipts | S': candidate diff<span class='blink'></span></div>",
        "    </main>",
        "",
        "    <script>",
        "      const rawLines = [",
        "        'read file, infer line numbers, draft raw diff...',",
        "        'maybe replace beta, maybe insert delta, re-count context...',",
        "        'emit patch text; hope hunk headers match current file...',",
        "        'retry after context drift; no typed receipt yet...',",
        "        'patch applies? maybe. semantic boundary still unclear.'",
        "      ];",
        "      const proxyLines = [",
        "        'ICL: examples select the transition shape',",
        "        'DSL: replace_line_containing(example.txt, beta, BETA)',",
        "        'DSL: insert_after_containing(example.txt, gamma, delta)',",
        "        'compile-dsl -> 2 typed edit ops',",
        "        'generate -> unified diff + receipt',",
        "        'apply -> S prime only after control checks'",
        "      ];",
        "      const rawDiff = [['-', 'beta'], ['+', 'BETA?'], ['?', 'hunk context guessed']];",
        "      const proxyDiff = [[' ', 'alpha'], ['-', 'beta'], ['+', 'BETA'], [' ', 'gamma'], ['+', 'delta']];",
        "      const els = {",
        "        rawStream: document.getElementById('rawStream'),",
        "        proxyStream: document.getElementById('proxyStream'),",
        "        rawDiff: document.getElementById('rawDiff'),",
        "        proxyDiff: document.getElementById('proxyDiff'),",
        "        rawOps: document.getElementById('rawOps'),",
        "        proxyOps: document.getElementById('proxyOps'),",
        "        rawBar: document.getElementById('rawBar'),",
        "        proxyBar: document.getElementById('proxyBar'),",
        "        rawPct: document.getElementById('rawPct'),",
        "        proxyPct: document.getElementById('proxyPct'),",
        "        receiptLine: document.getElementById('receiptLine')",
        "      };",
        "      let tick = 0;",
        "      function append(pre, lines, label) {",
        "        const next = lines[tick % lines.length];",
        "        pre.textContent += label + ' ' + next + '\\n';",
        "        const rows = pre.textContent.split('\\n').slice(-10);",
        "        pre.textContent = rows.join('\\n');",
        "      }",
        "      function renderDiff(target, rows) {",
        "        target.innerHTML = '';",
        "        rows.forEach((row, i) => {",
        "          const num = document.createElement('div');",
        "          num.className = 'line-no';",
        "          num.textContent = String(i + 1).padStart(2, '0');",
        "          const body = document.createElement('div');",
        "          body.className = row[0] === '+' ? 'plus' : row[0] === '-' ? 'minus' : '';",
        "          body.textContent = row[0] + ' ' + row[1];",
        "          target.append(num, body);",
        "        });",
        "      }",
        "      function loop() {",
        "        tick += 1;",
        "        append(els.rawStream, rawLines, 'codex>');",
        "        append(els.proxyStream, proxyLines, 'proxy>');",
        "        const raw = Math.min(94, 18 + tick * 7);",
        "        const proxy = Math.min(100, 26 + tick * 13);",
        "        els.rawOps.textContent = String(20 + (tick % 5) * 7);",
        "        els.proxyOps.textContent = tick < 8 ? String((tick * 178000).toLocaleString()) : '1.4M';",
        "        els.rawBar.style.width = raw + '%';",
        "        els.proxyBar.style.width = proxy + '%';",
        "        els.rawPct.textContent = raw + '%';",
        "        els.proxyPct.textContent = proxy + '%';",
        "        renderDiff(els.rawDiff, rawDiff.slice(0, 1 + (tick % rawDiff.length)));",
        "        renderDiff(els.proxyDiff, proxyDiff.slice(0, 1 + (tick % proxyDiff.length)));",
        "        els.receiptLine.innerHTML = tick % 3 === 0",
        "          ? 'Receipt: op_count=2 | file_count=1 | control=relative_paths,line_ranges,unified_diff<span class=\\'blink\\'></span>'",
        "          : 'S: repo files | Delta: DSL actions | C: path safety + anchors + receipts | S\\': candidate diff<span class=\\'blink\\'></span>';",
        "      }",
        "      renderDiff(els.rawDiff, rawDiff.slice(0, 1));",
        "      renderDiff(els.proxyDiff, proxyDiff.slice(0, 1));",
        "      loop();",
        "      setInterval(loop, 900);",
        "    </script>",
        "  </body>",
        "</html>"
      ]
    }
  ]
}
